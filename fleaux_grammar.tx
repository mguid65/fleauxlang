Program:
  statements*=Statement;

Statement:
  (ImportStatement | TypeStatement | AliasStatement | LetStatement | ExpressionStatement) ';';

// Runtime parser allows import names like `Std` and digit-leading forms
// like `20_export` (implemented as NUMBER + adjacent IDENT/NUMBER tokens).
ImportStatement:
  'import' module_name=ImportModuleName;

ImportModuleName:
  name=Identifier |
  first=NUMBER rest*=ImportModuleNamePart;

ImportModuleNamePart:
  part=NUMBER | part=Identifier;

OptionallyQualifiedId:
  QualifiedId | Identifier;

// Strong type declaration. Generic parameters are written in angle brackets.
// Runtime-provided types are declared with '__builtin__' and have no target type,
// e.g. type Result<T, E> :: __builtin__;
TypeStatement:
  'type' name=Identifier generic_params=OptionalGenericParamList sep=('=' | '::') (target=Type | builtin='__builtin__');

AliasStatement:
  'alias' name=Identifier '=' target=Type;

LetStatement:
  FunctionLetStatement | ValueLetStatement;

FunctionLetStatement:
  'let' id=OptionallyQualifiedId generic_params=OptionalGenericParamList '(' params=ParameterDeclList ')' ':' rtype=Type
  DeclarationDefinitionSeparator (expr=Expression | expr='__builtin__');

ValueLetStatement:
  'let' id=OptionallyQualifiedId ':' rtype=Type '=' expr=Expression;

// Generic parameters, each optionally bounded: <T, U: Int64 | UInt64>. Type declarations take parameters
// without bounds.
OptionalGenericParamList:
  '<' params+=GenericParam (',' params+=GenericParam)* '>' |
  ;

GenericParam:
  name=Identifier (':' bound=Type)?;

DeclarationDefinitionSeparator:
  '::' | '=';

ExpressionStatement:
  expr=Expression;

ParameterDeclList:
  params*=Parameter[','];

Parameter:
  param_name=Identifier ':' type=Type;

TypeList:
  types*=Type[','];

SimpleType:
  'Int64' | 'UInt64' | 'Float64' | 'String' | 'Bool' | 'Null' | 'Any' | 'Never';

Type:
  (base=SimpleType |
   base=TupleType |
   base=AppliedType |
   base=FunctionType |
   base=QualifiedId |
   base=Identifier)
  variadic?='...';

// Type arguments always use angle brackets, e.g. Tuple<Int64, String>, Tuple<T...>, Tuple<>.
TupleType:
  'Tuple' '<' TypeList '>';

// Named type with type arguments, e.g. Dict<String, Any> or Result<Bool, String>.
// The argument list may not be empty.
AppliedType:
  name=Identifier '<' TypeList '>';

// Function type, e.g. (Any, String) => Bool or () => Any
FunctionType:
  '(' TypeList ')' '=>' return_type=Type;

// Expression hierarchy in runtime parser:
// Expression -> FlowExpression
// FlowExpression -> Primary ('->' Primary)*
Expression:
  expr=FlowExpression;

FlowExpression:
  lhs=Primary ('->' rhs+=Primary)*;

Primary:
  base=Atom;

Atom:
  closure=ClosureExpression |
  block=BlockExpression |
  '(' inner=DelimitedExpression ')' |
  constant=Constant |
  named_target=NamedTarget |
  op=Operator;

BlockExpression:
  '{' items*=BlockItem result=Expression ';' '}';

BlockItem:
  LocalLetBinding ';' |
  ExpressionStatement ';';

LocalLetBinding:
  'let' name=Identifier ':' type=Type '=' expr=Expression;

NamedTarget:
  target=OptionallyQualifiedId explicit_type_args=OptionalExplicitTypeArgList;

OptionalExplicitTypeArgList:
  '<' args+=Type[','] '>' |
  ;

ClosureExpression:
  generic_params=OptionalGenericParamList '(' params=ParameterDeclList ')' ':' rtype=Type '=' body=Expression;

Operator:
  '^' |
  '/' |
  '*' |
  '%' |
  '+' |
  '-' |
  '==' |
  '!=' |
  '<' |
  '>' |
  '>=' |
  '<=' |
  '!' |
  '&&' |
  '||';

// Parentheses directly left of '->' (or a tuple template stage) are a parameter list: each item is one argument,
// and 'x...' spreads a tuple's items into it. A trailing comma, as in '(x,)' or '(a, b,)', makes the parentheses
// one tuple value instead, which cannot contain spreads.
DelimitedExpression:
  items*=DelimitedItem[','] trailing_comma?=',';

DelimitedItem:
  value=Expression spread?='...';

QualifiedId:
  qualifier=Qualifier id=NamespaceIdentifier;

Qualifier:
  head=NamespaceIdentifier ('.' tail*=NamespaceIdentifier)* '.';

Identifier:
  !Keyword ID;

// Namespace segments allow type keywords (String, Int64, Tuple, ...)
// but reject structural keywords.
NamespaceIdentifier:
  !StructuralKeyword ID;

Constant:
  val=NUMBER | val=STRING | val=BOOL | val='null';

StructuralKeyword:
  'let' | 'import' | 'alias' | '__builtin__';

Keyword:
  StructuralKeyword |
  'Int64' |
  'UInt64' |
  'Float64' |
  'String' |
  'Bool' |
  'Null' |
  'Any' |
  'Never' |
  'Tuple';

Comment:
  /\/\/.*/;
