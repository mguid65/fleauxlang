import Std;

// Python:
// def parse_port(text, default):
//     try:
//         return int(text)
//     except Exception:
//         return default
//
// Std.String.ParseInt64 returns a Result, Err when the text is not a number, so a default is one Std.Result.UnwrapOr
// away.

let ParsePort(text: String, fallback: Int64): Int64 =
    (text) -> Std.String.ParseInt64 -> (_, fallback) -> Std.Result.UnwrapOr;

("8080", 80) -> ParsePort -> Std.Println;
("oops", 80) -> ParsePort -> Std.Println;
