// The parallel stress program at 200 steps, run by Std.Tuple.Map on one thread.
import Std;

let WorkContinue(state: Tuple<Float64, Float64, Float64>): Bool =
    ((state, 0) -> Std.ElementAt, 0.0) -> Std.GreaterThan;
let WorkStep(state: Tuple<Float64, Float64, Float64>): Tuple<Float64, Float64, Float64> =
    (((state, 0) -> Std.ElementAt, 1.0) -> Std.Subtract,
     (state, 2) -> Std.ElementAt,
     ((state, 1) -> Std.ElementAt, (state, 2) -> Std.ElementAt) -> Std.Add);
let Work(n: Int64): Float64 = ((200.0, 0.0, 1.0), WorkContinue, WorkStep) -> Std.Loop -> (_, 1) -> Std.ElementAt;

((512) -> Std.Tuple.Range, Work) -> Std.Tuple.Map -> Std.Length -> Std.Println;
